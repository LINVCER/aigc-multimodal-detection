# ============================================================
# mobile-uniapp · 前端环境变量样例（复制到 .env 或 .env.local 后填值）
# ============================================================

# ---------- HTTP 请求前缀 ----------
# H5 dev 走 vite proxy 场景保持空：manifest.json 里 h5.devServer.proxy 已把 /api/* 转到后端
# 直连远程后端 / 小程序真机场景才填绝对地址：
#   VITE_API_BASE=https://api.paperaigc.com
VITE_API_BASE=

# ---------- 离线 mock 模式 ----------
# 显式开关。true = 全部 http/uploadFile 走 api/detect.js api/feedback.js 里的内置 mock 数据
# 默认关（走真实 HTTP）。新人只想跑 UI 不装后端时开 true
VITE_USE_MOCK=false

# ---------- 应用版本（Wave 4 · Batch 4.4 引入后 profile 页读取展示）----------
# VITE_APP_VERSION=0.2.0
