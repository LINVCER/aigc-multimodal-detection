# deploy/.env — 复制为 .env 后按需修改
# 一键起全栈: docker compose up -d --build
# 起 MLflow:  docker compose --profile mlops up -d

# ---- MySQL ----
# MYSQL_DATABASE 必须与后端 datasource 连的库名一致（standalone-app 默认取同名环境变量）
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_DATABASE=ry-vue
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change-me-in-production
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-please-change
MINIO_BUCKET=paper-aigc

# ---- JWT / Sa-Token ----
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# ---- 论文检测助手（Python assistant/，详见 docs/design/202610-paper-assistant-agent-research.md）----
# 不填 API key 助手端点返回 LLM_UNAVAILABLE，检测主链路不受影响
ASSISTANT_ENABLED=true
ASSISTANT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=qwen-plus
ASSISTANT_SAFETY_PROVIDER=none

# ---- 平台业务配置（platform.*；默认值见 business-modules/ruoyi-detect/src/main/resources/platform-defaults.yml）----
# compose 已为 backend 注入下面三个；此处列出以便按环境覆盖
# PLATFORM_INFERENCE_HOST=inference          # Python 推理服务地址
# PLATFORM_INFERENCE_PORT=8000
# PLATFORM_ASSISTANT_BASE_URL=http://inference:8000
# PLATFORM_INFERENCE_DEADLINE_SECONDS=15     # 单次推理请求超时
# PLATFORM_STORAGE_LOCAL_ROOT=/app/storage   # 论文原件落盘目录（已在 compose 内固定，勿轻易改）

# ---- 若依基座 clone 源（Gitee 国内快，GitHub 备选）----
RUOYI_GIT_URL=https://gitee.com/dromara/RuoYi-Vue-Plus.git
RUOYI_BRANCH=5.X

# ---- 管理端 plus-ui clone 源 ----
PLUS_UI_GIT_URL=https://gitee.com/JavaLionLi/plus-ui.git
PLUS_UI_BRANCH=master
