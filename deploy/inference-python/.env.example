# ============================================================
# 推理服务本地环境配置样例（复制到 .env 或 export 到 shell）
# ============================================================

# ---------- 文本检测 ----------
# checkpoint 路径（必填）。切换只换路径，代码/接口无需改：
#   1) 新一代生产模型（ml/training/text/train.py 产出）：自带 backbone 名、表层特征 scaler、判定阈值，
#      只配这一项即可。版本管理见 ml/VERSIONS.md
#      ./ml/checkpoints/text/v0.2.0-fusion-mdeberta/best.pth
#   2) legacy 兜底：./models/text/aigc_detector_v3_thesis.pth（无 hyperparams.arch，需同时配下面的基座路径）
TEXT_CHECKPOINT_PATH=./models/text/aigc_detector_v3_thesis.pth

# 基座路径（可选）。只在两种情况需要：
#   1) 上面用的是 legacy checkpoint —— 必填
#   2) 离线机器想用本地目录覆盖 checkpoint 里记录的 HF repo id（如 microsoft/mdeberta-v3-base）
TEXT_BASE_MODEL_PATH=./models/base/chinese-roberta-wwm-ext

# 推理设备：cpu / cuda:0
TEXT_DEVICE=cpu

# 单段最大 token 数；checkpoint.hyperparams.max_length 存在时覆盖此值
TEXT_MAX_LENGTH=512

# 报给后端 / 前端的模型版本标签（模型灰度用）；checkpoint.hyperparams.version 存在时覆盖此值
TEXT_MODEL_VERSION=aigc_v3_thesis

# ---------- 音频 / 图像 ----------
# 2026-09-20 主方向收敛为论文 AIGC 文本检测，音频 / 图像检测已归档，无对应配置项
