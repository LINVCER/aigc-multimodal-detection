# ============================================================
# 推理服务本地环境配置样例（复制到 .env 或 export 到 shell）
# ============================================================

# ---------- 文本检测 ----------
# 基座 RoBERTa 路径。二选一：
#   1) 本地 HF cache 目录（推荐；对应 train script trust_remote_code=True, local_files_only=True）
#   2) HuggingFace repo id（会走网络：hfl/chinese-roberta-wwm-ext）
TEXT_BASE_MODEL_PATH=./models/base/chinese-roberta-wwm-ext

# 训练好的分类头 + 校准参数 checkpoint（对齐 legacy/algorithms/train_text_detector.py 输出）
TEXT_CHECKPOINT_PATH=./models/text/aigc_detector_v3_thesis.pth

# 推理设备：cpu / cuda:0
TEXT_DEVICE=cpu

# 单段最大 token 数；checkpoint.hyperparams.max_length 存在时覆盖此值
TEXT_MAX_LENGTH=512

# 报给后端 / 前端的模型版本标签（模型灰度用）
TEXT_MODEL_VERSION=aigc_v3_thesis

# ---------- 图像 / 音频 / 篡改 ----------
# Wave 4 后续 batch 接入；接入前保持 stub
# IMAGE_CHECKPOINT_PATH=./models/image/cnn_detection.pth
# AUDIO_CHECKPOINT_PATH=./models/audio/aigc_audio_classifier.pth
# TAMPERING_CHECKPOINT_PATH=./models/tampering/best_model.pth
