# ============================================================
# 推理服务本地环境配置样例（复制到 .env 或 export 到 shell）
# ============================================================

# ---------- 文本检测 ----------
# 基座 RoBERTa 路径。二选一：
#   1) 本地 HF cache 目录（推荐；对应 train script trust_remote_code=True, local_files_only=True）
#   2) HuggingFace repo id（会走网络：hfl/chinese-roberta-wwm-ext）
TEXT_BASE_MODEL_PATH=./models/base/chinese-roberta-wwm-ext

# checkpoint 路径。二选一（切换只换路径，代码/接口无需改）：
#   1) legacy 兜底（当前）：./models/text/aigc_detector_v3_thesis.pth
#      来自 legacy/algorithms/train_text_detector.py，非产品线正式模型
#   2) 新一代生产模型（v0.1.0-baseline 训完后）：
#      ./ml/checkpoints/text/v0.1.0-baseline/best.pth
#      版本管理见 ml/VERSIONS.md
TEXT_CHECKPOINT_PATH=./models/text/aigc_detector_v3_thesis.pth

# 推理设备：cpu / cuda:0
TEXT_DEVICE=cpu

# 单段最大 token 数；checkpoint.hyperparams.max_length 存在时覆盖此值
TEXT_MAX_LENGTH=512

# 报给后端 / 前端的模型版本标签（模型灰度用）
TEXT_MODEL_VERSION=aigc_v3_thesis

# ---------- 音频检测 ----------
# 骨架已就位（detectors/audio.py）；加载 & predict 实现待 Wave 5 · ml/training/audio 训练启动后填充
# 未配置时 /api/v1/detect/audio 端点走 MD5 stub 兜底（伪 segments + duration），不影响链路联调
# AUDIO_BASE_MODEL_PATH=./models/base/wav2vec2-base
# AUDIO_CHECKPOINT_PATH=./ml/checkpoints/audio/v0.1.0-baseline/best.pth
# AUDIO_DEVICE=cpu
# AUDIO_WINDOW_SEC=3.0
# AUDIO_STRIDE_SEC=1.0
# AUDIO_MODEL_VERSION=audio_v0

